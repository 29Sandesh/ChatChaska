# ============================================================
# ChatChaska POS & Cafe Management — Environment Configuration
# ============================================================

# 1. Groq AI API Key (For AI Menu Extraction & Smart Upsell)
GROQ_API_KEY=your_groq_api_key_here

# 2. Supabase Multi-Tenant Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. Cryptographic Session Secret (Min 32 characters for HMAC SHA-256)
SESSION_SECRET=your_32_character_random_secret_here

# 4. Super Admin Master Credentials
SUPER_ADMIN_EMAIL=admin@chatchaska.com
SUPER_ADMIN_PASSWORD=change_this_in_production

# 5. Application Environment
NODE_ENV=production
PORT=5678
